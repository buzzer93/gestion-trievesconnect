# --> Environment variables loaded when APP_ENV=test <--

APP_SECRET='test_only_secret_do_not_use_in_prod'

# Base SQLite dédiée aux tests, séparée de var/data.db (dev local) : les
# tests créent/suppriment des lignes (postes, clients, utilisateurs) et ne
# doivent jamais toucher aux données réelles de dev (cf. incident du
# 2026-07-06 : un test avait supprimé puis recréé un compte utilisateur et
# un client existants en cherchant par email/téléphone sur la base
# partagée). La prod reste MariaDB (cf. DATABASE_URL dans .env). Les
# migrations du projet gèrent déjà les deux moteurs (cf.
# Version20260704152053.php et suivantes).
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_test.db"
