# --> Environment variables loaded when APP_ENV=test <--

APP_SECRET='test_only_secret_do_not_use_in_prod'

# Réutilise la même base SQLite que le dev local (var/data.db) : évite de
# dépendre d'un serveur MariaDB local (la prod reste MariaDB, cf. DATABASE_URL
# dans .env). Les migrations du projet gèrent déjà les deux moteurs
# (cf. Version20260704152053.php et suivantes).
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
