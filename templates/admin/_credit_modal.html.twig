{#
  admin/_credit_modal.html.twig — Modale "gérer le solde d'impression"

  Partagée entre clients et associations. Doit être incluse à l'intérieur
  d'un élément data-controller="credit-modal" (cf. credit_modal_controller.js)
  qui englobe aussi le(s) bouton(s) déclencheurs (.credit-btn) -- ce sont ces
  boutons qui posent les data-credit-modal-*-param (id, soldes courants) et
  data-credit-modal-focus-param ("personal" ou "municipal") qui détermine
  quelles sections la modale affiche : cliquer sur "Solde personnel" ne
  montre que la gestion du solde personnel (+ débit impression), cliquer
  sur "Solde mairie" ne montre que la gestion du crédit mairie -- pour
  éviter la confusion d'avoir les deux soldes actionnables en même temps
  (cf. retour utilisateur du 2026-08-25).

  Params :
    has_municipal  bool  autorise l'affichage de la section solde mairie
                         (association) -- le focus détermine ensuite si
                         elle est effectivement montrée à l'ouverture.
#}

<div id="creditModal"
     data-controller="modal"
     data-credit-modal-target="modalRoot"
     class="hidden fixed inset-0 z-50 items-center justify-center p-4"
     aria-labelledby="creditModalTitle">
    <div data-modal-target="backdrop"
         data-action="click->modal#hideOnBackdrop"
         class="absolute inset-0 bg-black/70"></div>

    <div data-modal-target="dialog"
         role="dialog" aria-modal="true"
         class="relative w-full max-w-2xl bg-surface-300 border border-border rounded-md shadow-elevated max-h-[90vh] overflow-y-auto">

        <div class="flex items-center justify-between px-5 py-3 border-b-2 border-accent">
            <h5 class="font-display font-bold uppercase tracking-wide text-base m-0" id="creditModalTitle" data-credit-modal-target="title">Gérer le solde</h5>
            <button type="button"
                    data-action="modal#hide"
                    class="text-text-muted hover:text-text-primary transition-colors w-8 h-8 inline-flex items-center justify-center"
                    aria-label="Fermer">
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            </button>
        </div>

        <div class="p-5">
            <div class="flex flex-col gap-6">

                <div class="flex items-center justify-between bg-surface-200 border border-border rounded-sm px-4 py-3">
                    <span class="text-xs font-bold uppercase tracking-wide text-text-soft" data-credit-modal-target="balanceLabel">Solde actuel</span>
                    <span class="font-mono font-bold text-lg text-gold">
                        <span data-credit-modal-target="balanceValue">0.00</span> €
                    </span>
                </div>

                <section data-credit-modal-target="personalCreditSection">
                    <h6 class="m-0 mb-3 font-display font-bold text-xs uppercase tracking-wide text-text-soft">
                        <i class="fa-solid fa-circle-plus text-accent mr-1.5" aria-hidden="true"></i>
                        Ajouter au solde personnel
                    </h6>
                    <div class="flex flex-col sm:flex-row gap-2">
                        <div class="flex grow rounded-sm overflow-hidden border border-border">
                            <span class="inline-flex items-center px-3 bg-surface-400 text-text-soft text-sm font-mono">€</span>
                            <input type="number" min="0.01" step="0.01" value="1.00"
                                   data-credit-modal-target="amount"
                                   class="block w-full bg-surface-200 text-text-primary border-0 px-3 py-2 text-sm focus:outline-none focus:bg-surface-100">
                        </div>
                        <button type="button"
                                data-action="credit-modal#addCredit"
                                class="inline-flex items-center justify-center gap-2 bg-transparent text-accent border-2 border-accent font-display font-bold uppercase tracking-wide text-sm px-4 py-2 rounded-md hover:bg-accent hover:text-bg transition-colors">
                            <i class="fa-solid fa-plus" aria-hidden="true"></i>
                            <span>Ajouter</span>
                        </button>
                    </div>
                </section>

                {% if has_municipal|default(false) %}
                    <section data-credit-modal-target="municipalCreditSection" class="hidden">
                        <h6 class="m-0 mb-3 font-display font-bold text-xs uppercase tracking-wide text-text-soft">
                            <i class="fa-solid fa-landmark text-gold mr-1.5" aria-hidden="true"></i>
                            Ajouter au solde mairie
                        </h6>
                        <div class="flex flex-col sm:flex-row gap-2">
                            <div class="flex grow rounded-sm overflow-hidden border border-border">
                                <span class="inline-flex items-center px-3 bg-surface-400 text-text-soft text-sm font-mono">€</span>
                                <input type="number" min="0.01" step="0.01" value="1.00"
                                       data-credit-modal-target="municipalAmount"
                                       class="block w-full bg-surface-200 text-text-primary border-0 px-3 py-2 text-sm focus:outline-none focus:bg-surface-100">
                            </div>
                            <button type="button"
                                    data-action="credit-modal#addMunicipalCredit"
                                    class="inline-flex items-center justify-center gap-2 bg-transparent text-gold border-2 border-gold font-display font-bold uppercase tracking-wide text-sm px-4 py-2 rounded-md hover:bg-gold hover:text-bg transition-colors">
                                <i class="fa-solid fa-plus" aria-hidden="true"></i>
                                <span>Ajouter</span>
                            </button>
                        </div>
                    </section>

                    <div data-credit-modal-target="municipalPrintChargeSection" class="hidden">
                        <hr class="border-border m-0 mb-6">

                        <section>
                            <h6 class="m-0 mb-3 font-display font-bold text-xs uppercase tracking-wide text-text-soft">
                                <i class="fa-solid fa-print text-warning mr-1.5" aria-hidden="true"></i>
                                Débiter pour impression (crédit mairie)
                            </h6>

                            <div class="grid grid-cols-2 gap-3 mb-3">
                                <div>
                                    <label class="block text-xs font-bold uppercase tracking-wide text-text-soft mb-1.5">Mode couleur</label>
                                    <select data-credit-modal-target="municipalColorMode"
                                            data-action="change->credit-modal#recomputeMunicipalEstimate"
                                            class="block w-full bg-surface-200 text-text-primary border border-border rounded-sm px-3 py-2 text-sm focus:outline-none focus:border-accent">
                                        <option value="MONOCHROME">Monochrome</option>
                                        <option value="COLOR">Couleur</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-xs font-bold uppercase tracking-wide text-text-soft mb-1.5">Format</label>
                                    <select data-credit-modal-target="municipalPaperSize"
                                            data-action="change->credit-modal#recomputeMunicipalEstimate"
                                            class="block w-full bg-surface-200 text-text-primary border border-border rounded-sm px-3 py-2 text-sm focus:outline-none focus:border-accent">
                                        <option value="A4">A4</option>
                                        <option value="A3">A3</option>
                                    </select>
                                </div>
                            </div>

                            <div class="flex flex-col sm:flex-row gap-3 mb-3">
                                <div class="flex grow rounded-sm overflow-hidden border border-border">
                                    <span class="inline-flex items-center px-3 bg-surface-400 text-text-soft text-xs font-bold uppercase tracking-wide">Quantité</span>
                                    <input type="number" min="1" step="1" value="1"
                                           data-credit-modal-target="municipalCopies"
                                           data-action="change->credit-modal#recomputeMunicipalEstimate input->credit-modal#recomputeMunicipalEstimate"
                                           class="block w-full bg-surface-200 text-text-primary border-0 px-3 py-2 text-sm focus:outline-none focus:bg-surface-100">
                                </div>
                            </div>

                            <p class="text-xs text-text-muted mb-3">
                                <i class="fa-solid fa-circle-info mr-1" aria-hidden="true"></i>
                                Débite uniquement le crédit mairie -- refusé si celui-ci ne couvre pas le montant (pas de bascule sur le solde personnel ici).
                            </p>

                            <div class="flex items-center justify-between bg-surface-200 border border-border rounded-sm px-4 py-3 mb-4">
                                <span class="text-xs font-bold uppercase tracking-wide text-text-soft">Coût estimé</span>
                                <span class="font-mono font-bold text-base text-warning">
                                    <strong data-credit-modal-target="municipalEstimatedCost">0.00</strong> €
                                </span>
                            </div>

                            <div class="flex justify-end">
                                <button type="button"
                                        data-action="credit-modal#chargeMunicipalPrint"
                                        class="inline-flex items-center justify-center gap-2 bg-transparent text-warning border-2 border-warning font-display font-bold uppercase tracking-wide text-sm px-4 py-2 rounded-md hover:bg-warning hover:text-bg transition-colors">
                                    <i class="fa-solid fa-minus" aria-hidden="true"></i>
                                    <span>Débiter</span>
                                </button>
                            </div>
                        </section>
                    </div>
                {% endif %}

                <div data-credit-modal-target="printChargeSection">
                    <hr class="border-border m-0 mb-6">

                    <section>
                        <h6 class="m-0 mb-3 font-display font-bold text-xs uppercase tracking-wide text-text-soft">
                            <i class="fa-solid fa-print text-warning mr-1.5" aria-hidden="true"></i>
                            Débiter pour impression
                        </h6>

                        <div class="grid grid-cols-2 gap-3 mb-3">
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wide text-text-soft mb-1.5">Mode couleur</label>
                                <select data-credit-modal-target="colorMode"
                                        data-action="change->credit-modal#recomputeEstimate"
                                        class="block w-full bg-surface-200 text-text-primary border border-border rounded-sm px-3 py-2 text-sm focus:outline-none focus:border-accent">
                                    <option value="MONOCHROME">Monochrome</option>
                                    <option value="COLOR">Couleur</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wide text-text-soft mb-1.5">Format</label>
                                <select data-credit-modal-target="paperSize"
                                        data-action="change->credit-modal#recomputeEstimate"
                                        class="block w-full bg-surface-200 text-text-primary border border-border rounded-sm px-3 py-2 text-sm focus:outline-none focus:border-accent">
                                    <option value="A4">A4</option>
                                    <option value="A3">A3</option>
                                </select>
                            </div>
                        </div>

                        <div class="flex flex-col sm:flex-row gap-3 mb-3">
                            <div class="flex grow rounded-sm overflow-hidden border border-border">
                                <span class="inline-flex items-center px-3 bg-surface-400 text-text-soft text-xs font-bold uppercase tracking-wide">Quantité</span>
                                <input type="number" min="1" step="1" value="1"
                                       data-credit-modal-target="copies"
                                       data-action="change->credit-modal#recomputeEstimate input->credit-modal#recomputeEstimate"
                                       class="block w-full bg-surface-200 text-text-primary border-0 px-3 py-2 text-sm focus:outline-none focus:bg-surface-100">
                            </div>
                        </div>

                        {% if has_municipal|default(false) %}
                            <p class="text-xs text-text-muted mb-3">
                                <i class="fa-solid fa-circle-info mr-1" aria-hidden="true"></i>
                                Le crédit mairie est débité en priorité ; le solde personnel ne couvre que le reliquat.
                            </p>
                        {% endif %}

                        <div class="flex items-center justify-between bg-surface-200 border border-border rounded-sm px-4 py-3 mb-4">
                            <span class="text-xs font-bold uppercase tracking-wide text-text-soft">Coût estimé</span>
                            <span class="font-mono font-bold text-base text-warning">
                                <strong data-credit-modal-target="estimatedCost">0.00</strong> €
                            </span>
                        </div>

                        <div class="flex justify-end">
                            <button type="button"
                                    data-action="credit-modal#chargePrint"
                                    class="inline-flex items-center justify-center gap-2 bg-transparent text-warning border-2 border-warning font-display font-bold uppercase tracking-wide text-sm px-4 py-2 rounded-md hover:bg-warning hover:text-bg transition-colors">
                                <i class="fa-solid fa-minus" aria-hidden="true"></i>
                                <span>Débiter</span>
                            </button>
                        </div>
                    </section>
                </div>
            </div>
        </div>

        <div class="flex justify-between px-5 py-3 border-t border-border bg-surface-200">
            <button type="button"
                    data-action="modal#hide"
                    class="inline-flex items-center gap-2 px-3 py-1.5 rounded-sm text-xs font-bold uppercase tracking-wide text-text-soft hover:text-text-primary transition-colors">
                Fermer
            </button>
        </div>
    </div>
</div>
