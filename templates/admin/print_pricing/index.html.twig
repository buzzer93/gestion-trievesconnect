{% extends 'base.html.twig' %}

{% block title %}Tarifs d'impression · Trieves Connect Manager{% endblock %}

{% block body %}
    {% include 'components/_page_header.html.twig' with {
        title: 'Tarifs d\'impression',
        subtitle: 'Prix par copie selon le mode couleur et le format de papier.',
    } only %}

    {% embed 'components/_card.html.twig' with { padding: 'lg', rates: rates } only %}
        {% block body %}
            <form method="post" action="{{ path('admin.print_pricing.index') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('print_pricing_edit') }}">

                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Mode couleur</th>
                            <th>Format</th>
                            <th>Prix par copie (€)</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for rate in rates %}
                            <tr>
                                <td>{{ rate.colorMode == 'COLOR' ? 'Couleur' : 'Monochrome' }}</td>
                                <td>{{ rate.paperSize }}</td>
                                <td>
                                    <input type="number" step="0.01" min="0" name="price_{{ rate.id }}"
                                           value="{{ (rate.priceCents / 100)|number_format(2, '.', '') }}"
                                           class="bg-surface-200 border border-border rounded-md px-3 py-1.5 text-sm w-32">
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="3" class="text-center text-text-muted py-6">
                                    Aucun tarif configuré.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>

                <div class="flex items-center gap-3 mt-6 pt-4 border-t border-border">
                    <button type="submit" class="inline-flex items-center justify-center gap-2 bg-accent text-bg font-display font-semibold text-sm px-4 py-2 rounded-md border border-accent hover:bg-accent-hover hover:border-accent-hover transition-colors duration-150 focus:outline-none focus:shadow-focus">
                        Enregistrer
                    </button>
                </div>
            </form>
        {% endblock %}
    {% endembed %}
{% endblock %}
