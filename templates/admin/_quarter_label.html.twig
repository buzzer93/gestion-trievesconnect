{#
  admin/_quarter_label.html.twig — Libellé d'un trimestre scolaire avec les mois inclus

  Trimestre SCOLAIRE (pas calendaire), décision du 2026-08-26 :
    T1 = Septembre - Décembre
    T2 = Janvier - Avril
    T3 = Mai - Août
  Mois fixes chaque année (pas les dates officielles Éducation Nationale).
  Cf. PrintTransactionLineRepository::quarterBounds() pour la même logique côté requêtes.

  Usage :
    {% import 'admin/_quarter_label.html.twig' as quarter_label %}
    {{ quarter_label.full(quarter, year) }}     {# "Septembre - Décembre 2026" #}
    {{ quarter_label.short(quarter, year) }}    {# "Sept.-Déc. 2026" #}
#}

{% macro full(quarter, year) %}
    {%- set months = {
        1: ['Septembre', 'Décembre'],
        2: ['Janvier', 'Avril'],
        3: ['Mai', 'Août'],
    } -%}
    {{- months[quarter][0] }} - {{ months[quarter][1] }} {{ year -}}
{% endmacro %}

{% macro short(quarter, year) %}
    {%- set months = {
        1: ['Sept.', 'Déc.'],
        2: ['Janv.', 'Avr.'],
        3: ['Mai', 'Août'],
    } -%}
    {{- months[quarter][0] }}-{{ months[quarter][1] }} {{ year -}}
{% endmacro %}
