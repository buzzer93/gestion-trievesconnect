{% extends 'base.html.twig' %}

{% block title %}Budget mairie · Trieves Connect Manager{% endblock %}

{% block body %}
    {% include 'components/_page_header.html.twig' with {
        title: 'Budget mairie',
        subtitle: 'Forfait annuel accordé à chaque association, renouvelé le 1er janvier.',
    } only %}

    {% embed 'components/_card.html.twig' with { padding: 'lg', settings: settings } only %}
        {% block body %}
            <form method="post" action="{{ path('admin.municipal_budget.index') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('municipal_budget_edit') }}">

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm text-text-soft mb-1" for="annual_page_allowance">Nombre de pages annuel</label>
                        <input type="number" step="1" min="0" id="annual_page_allowance" name="annual_page_allowance"
                               value="{{ settings.annualPageAllowance }}"
                               class="bg-surface-200 border border-border rounded-md px-3 py-1.5 text-sm w-full">
                    </div>
                    <div>
                        <label class="block text-sm text-text-soft mb-1" for="price_per_page_euros">Prix par page (€)</label>
                        <input type="number" step="0.01" min="0" id="price_per_page_euros" name="price_per_page_euros"
                               value="{{ (settings.pricePerPageCents / 100)|number_format(2, '.', '') }}"
                               class="bg-surface-200 border border-border rounded-md px-3 py-1.5 text-sm w-full">
                    </div>
                </div>

                <p class="text-sm text-text-soft mt-4">
                    Forfait annuel total : <span class="text-gold font-bold">{{ (settings.annualAllowanceCents / 100)|number_format(2, ',', '') }} €</span>
                </p>

                <div class="flex items-center gap-3 mt-6 pt-4 border-t border-border">
                    <button type="submit" class="inline-flex items-center justify-center gap-2 bg-accent text-bg font-display font-semibold text-sm px-4 py-2 rounded-md border border-accent hover:bg-accent-hover hover:border-accent-hover transition-colors duration-150 focus:outline-none focus:shadow-focus">
                        Enregistrer
                    </button>
                </div>
            </form>
        {% endblock %}
    {% endembed %}
{% endblock %}
