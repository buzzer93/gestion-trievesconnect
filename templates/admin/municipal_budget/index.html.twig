{% extends 'base.html.twig' %}
{% import 'admin/_quarter_label.html.twig' as quarter_label %}

{% block title %}Budget mairie · Trieves Connect Manager{% endblock %}

{% block body %}
    {% include 'components/_page_header.html.twig' with {
        title: 'Budget mairie',
        subtitle: 'Forfait annuel accordé à chaque association -- rechargé manuellement, pas de renouvellement automatique.',
    } only %}

    {% embed 'components/_card.html.twig' with { padding: 'lg', settings: settings } only %}
        {% block body %}
            <form method="post" action="{{ path('admin.municipal_budget.index') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('municipal_budget_edit') }}">

                <div class="max-w-xs">
                    <label class="block text-sm text-text-soft mb-1" for="annual_allowance_euros">Forfait mairie annuel (€)</label>
                    <input type="number" step="0.01" min="0" id="annual_allowance_euros" name="annual_allowance_euros"
                           value="{{ (settings.annualAllowanceCents / 100)|number_format(2, '.', '') }}"
                           class="bg-surface-200 border border-border rounded-md px-3 py-1.5 text-sm w-full">
                    <p class="text-xs text-text-muted mt-1">Montant crédité à chaque association lors du renouvellement du 1er janvier.</p>
                </div>

                <div class="flex items-center gap-3 mt-6 pt-4 border-t border-border">
                    <button type="submit" class="inline-flex items-center justify-center gap-2 bg-accent text-bg font-display font-semibold text-sm px-4 py-2 rounded-md border border-accent hover:bg-accent-hover hover:border-accent-hover transition-colors duration-150 focus:outline-none focus:shadow-focus">
                        Enregistrer
                    </button>
                </div>
            </form>

            <form method="post" action="{{ path('admin.municipal_budget.renew') }}" class="mt-4 pt-4 border-t border-border"
                  onsubmit="return confirm('Recharger le crédit mairie de TOUTES les associations à ' + document.getElementById('annual_allowance_euros').value + ' € ? Le solde mairie actuel de chaque association sera remplacé (le reliquat non consommé est perdu, pas cumulé).');">
                <input type="hidden" name="_token" value="{{ csrf_token('municipal_budget_renew') }}">
                <button type="submit" class="inline-flex items-center justify-center gap-2 bg-transparent text-gold border-2 border-gold font-display font-bold uppercase tracking-wide text-sm px-4 py-2 rounded-md hover:bg-gold hover:text-bg transition-colors">
                    <i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i>
                    Recharger maintenant toutes les associations
                </button>
                <p class="text-xs text-text-muted mt-2">
                    Déclenchement manuel uniquement -- aucun renouvellement automatique n'a lieu au 1er janvier. Enregistrez d'abord le montant ci-dessus si vous le changez.
                </p>
            </form>
        {% endblock %}
    {% endembed %}

    <h6 class="font-display font-bold text-xs uppercase tracking-wide text-text-soft mt-8 mb-3">
        Consommation du crédit mairie par association
    </h6>

    <div class="flex items-center justify-between mb-5 max-w-xl">
        {% include 'components/_button.html.twig' with {
            label: quarter_label.short(prevQuarter, prevYear),
            variant: 'ghost',
            size: 'sm',
            icon: 'fa-solid fa-chevron-left',
            href: path('admin.municipal_budget.index', {year: prevYear, quarter: prevQuarter}),
        } only %}
        <span class="font-display font-bold uppercase tracking-wide text-text-primary">
            {{ quarter_label.full(quarter, year) }}
        </span>
        {% include 'components/_button.html.twig' with {
            label: quarter_label.short(nextQuarter, nextYear),
            variant: 'ghost',
            size: 'sm',
            icon: 'fa-solid fa-chevron-right',
            href: path('admin.municipal_budget.index', {year: nextYear, quarter: nextQuarter}),
        } only %}
    </div>

    <table class="data-table">
        <thead>
            <tr>
                <th>Association</th>
                <th>Montant mairie consommé</th>
            </tr>
        </thead>
        <tbody>
            {% for row in byAssociation %}
                <tr data-controller="row-link"
                    data-row-link-url-value="{{ path('admin.association.show', {id: row.association.id}) }}">
                    <td>
                        <a class="data_name" href="{{ path('admin.association.show', {id: row.association.id}) }}">{{ row.association.name }}</a>
                    </td>
                    <td class="font-mono text-sm text-gold font-bold">{{ (row.amountCents / 100)|number_format(2, ',', '') }} €</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="2" class="text-center text-text-muted py-6">
                        Aucune association pour l'instant.
                    </td>
                </tr>
            {% endfor %}
        </tbody>
        <tfoot>
            <tr class="font-bold">
                <td class="text-right uppercase text-xs tracking-wide text-text-soft">Total à facturer</td>
                <td class="font-mono text-gold">{{ (totalCents / 100)|number_format(2, ',', '') }} €</td>
            </tr>
        </tfoot>
    </table>
{% endblock %}
