{% extends 'base.html.twig' %}

{% block title %}Poste {{ device.hostname }} · Trieves Connect Manager{% endblock %}

{% block body %}
    {% embed 'components/_page_header.html.twig' with {
        title: device.hostname,
        subtitle: 'Modifier le poste PrintGate.',
    } only %}
        {% block actions %}
            {% include 'components/_button.html.twig' with {
                label: 'Retour à la liste',
                variant: 'ghost',
                icon: 'fa-solid fa-arrow-left',
                href: path('admin.printgate_device.index'),
            } only %}
        {% endblock %}
    {% endembed %}

    {% embed 'components/_card.html.twig' with { padding: 'lg', form: form, device: device } only %}
        {% block body %}
            {% include 'admin/printgate_device/_form.html.twig' with { form: form } only %}
        {% endblock %}
    {% endembed %}
{% endblock %}
